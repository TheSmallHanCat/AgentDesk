{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentdesk:protocol:1.0:hello",
  "title": "AgentDesk hello handshake",
  "description": "AgentDesk 协议 1.x 握手；主版本不匹配时拒绝连接。",
  "$defs": {
    "ResumeCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lastSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "lastSeq"
      ]
    },
    "AgentCapability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "installed": {
          "type": "boolean"
        },
        "loggedIn": {
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "permissionModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resume": {
          "type": "boolean"
        },
        "approvals": {
          "type": "boolean"
        },
        "stop": {
          "type": "boolean"
        },
        "appendInput": {
          "type": "boolean"
        },
        "sdkVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "accountType": {
          "type": [
            "string",
            "null"
          ]
        },
        "handshake": {
          "type": "boolean"
        },
        "resourcesAvailable": {
          "type": "boolean"
        },
        "sandboxAvailable": {
          "type": "boolean"
        },
        "authStatus": {
          "type": "string",
          "enum": [
            "missing",
            "loggedOut",
            "loggedIn",
            "failed",
            "checking"
          ]
        }
      },
      "required": [
        "available",
        "streaming"
      ]
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectionId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "requestSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "connectionId",
        "requestSeq"
      ]
    },
    "HelloParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "client": {
          "type": "string"
        },
        "deviceId": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        },
        "os": {
          "type": "string",
          "enum": [
            "windows",
            "macos",
            "linux"
          ]
        },
        "resume": {
          "$ref": "#/$defs/ResumeCursor"
        }
      },
      "required": [
        "protocolVersion",
        "client",
        "deviceId",
        "deviceName",
        "os"
      ]
    },
    "HelloResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "type": "string",
          "const": "1.0"
        },
        "host": {
          "type": "string"
        },
        "hostId": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AgentCapability"
          }
        },
        "currentSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "protocolVersion",
        "host",
        "hostId",
        "capabilities",
        "currentSeq"
      ]
    },
    "HelloRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "integer"
        },
        "method": {
          "type": "string",
          "const": "hello"
        },
        "params": {
          "$ref": "#/$defs/HelloParams"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ]
    },
    "HelloResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "integer"
        },
        "result": {
          "$ref": "#/$defs/HelloResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/HelloRequest"
    },
    {
      "$ref": "#/$defs/HelloResponse"
    }
  ]
}
